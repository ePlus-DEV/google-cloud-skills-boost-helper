{
  "version": "2.0.0",
  "windows": {
    "options": {
      "env": {
        // Prefer the active NVM Node over Laragon's bundled Node.
        "PATH": "${env:NVM_SYMLINK};${env:PATH}"
      },
      "shell": {
        "executable": "cmd.exe",
        "args": ["/d", "/c"]
      }
    }
  },
  "tasks": [
    {
      "label": "run dev",
      "type": "shell",
      "command": "yarn install && yarn dev",
      "windows": {
        "command": "corepack yarn install && corepack yarn dev"
      },
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "one"
      },
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": []
    },
    {
      "label": "run dev w/o install",
      "type": "shell",
      "command": "yarn dev",
      "windows": {
        "command": "corepack yarn dev"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "one"
      },
      "problemMatcher": []
    },
    {
      "label": "run build",
      "type": "shell",
      "command": "yarn build",
      "windows": {
        "command": "corepack yarn build"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "one"
      },
      "problemMatcher": []
    },
    {
      "label": "run build zip",
      "type": "shell",
      "command": "yarn build && yarn zip",
      "windows": {
        "command": "corepack yarn build && corepack yarn zip"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "one"
      },
      "problemMatcher": []
    }
  ]
}
